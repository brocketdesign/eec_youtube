# Resend API Key — get yours at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# MongoDB connection string — get yours from your MongoDB Atlas dashboard
MONGO_URI=your_mongodb_connection_string_here

# Your site URL (used in email links)
SITE_URL=http://localhost:5173

# Stripe — get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# AI Providers — set at least one
SEGMIND_API_KEY=your_segmind_api_key_here
OPENAI_API_KEY=sk-your_key_here
GROK_API_KEY=xai-your_key_here

# Brevo CRM — get key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Optional: FireCrawl for channel analysis — https://firecrawl.dev
FIRECRAWL_API_KEY=

# Optional: Tavily for web search context — https://tavily.com
TAVILY_API_KEY=
